<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <AssemblyName>Bernael.DarkMirageDemo</AssemblyName>
    <RootNamespace>Bernael.DarkMirageDemo</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Optimize>true</Optimize>
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\..\RimWorldWin64_Data\Managed</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManagedDir)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(GameManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ImageConversionModule"><HintPath>$(GameManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.ScreenCaptureModule" Condition="'$(DefineConstants)' == 'MIRAGE_QA'"><HintPath>$(GameManagedDir)\UnityEngine.ScreenCaptureModule.dll</HintPath><Private>false</Private></Reference>
    <Compile Include="DarkMirage.cs" />
    <Compile Include="MirageVisuals.cs" />
    <Compile Include="..\DarkMirageUnity\Assets\Shared\MirageDistanceField.cs" />
    <Compile Include="DebugActions.cs" />
    <Compile Include="MirageQaHarness.cs" Condition="'$(DefineConstants)' == 'MIRAGE_QA' And Exists('MirageQaHarness.cs')" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
