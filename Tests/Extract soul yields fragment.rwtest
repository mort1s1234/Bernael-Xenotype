rwtest 1
test "Extract soul yields fragment" project=Bernael group=Harvest created=2026-09-18T00:00:00

# The prisoner is built into a cell and not left standing on open ground,
# because a prisoner outside one starts its escape job and walks off the map
# edge while the test is still running - the surgery then runs on a pawn that
# is no longer where the test put it, or no longer there at all. A room is a
# prison cell only once a prisoner bed stands in it, which is the game's own
# chain, so the bed goes in before the prisoner does.
#
# The second room is where everyone who is not a prisoner waits. A spawn with
# neither "at" nor "in" searches outward from the map centre, which is where
# the cell was built, so the doctor would otherwise be dropped into the cell
# with the patient.
#
# The fragment is asserted "present" and not on a cell: OnSurgerySuccess places
# it with ThingPlaceMode.Near, so the exact cell is the game's to pick.

requires dlc=Biotech

room size=5,5 prison=true name="cell"
room size=5,5 name="ward"
spawn Thing:Bed in="cell"

spawn Pawn:Colonist in="ward" name="Doctor"
spawn Pawn:Colonist in="cell" name="Prisoner"
prisoner "Prisoner" resistance=10
assert pawn "Prisoner" room=PrisonCell

bill "Prisoner" recipe=BX_ExtractSoul expect=absent
spawn Pawn:Colonist in="ward" name="Bernael" xenotype=BX_Bernael
bill "Prisoner" recipe=BX_ExtractSoul
surgery "Prisoner" recipe=BX_ExtractSoul by="Doctor"
assert pawn "Prisoner" hediff=BX_SoulDrained severity min=0.94 max=0.96
assert thing BX_BottledSoul expect=present
surgery "Prisoner" recipe=BX_ExtractSoul by="Doctor"
assert pawn "Prisoner" hediff=BX_SoulDrained severity max=0.96
assert log clean
