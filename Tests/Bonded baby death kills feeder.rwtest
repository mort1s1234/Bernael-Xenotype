rwtest 1
test "Bonded baby death kills feeder" project="Bernael" group="Bond" created=2026-09-18T00:00:00

# HediffComp_BabyBond_Victim.Notify_PawnDied kills the bonded feeder with
# 99999 Deterioration damage. That is the sharpest rule in the whole mod and it
# fires from a callback nobody would notice failing: if the comp is ever removed
# too early - CompShouldRemove drops it the moment BondedFeeder is null or dead -
# the baby just dies quietly and the feeder walks away.
#
# The bond is built the same way as in "Baby drain creates bond".

requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Pawn:Colonist at 1,0 name="Baby" age=1

give "Bernael" resource=BX_SoulStarved value=0.1
cast "Bernael" ability=BX_SoulFeeding target="Baby"
tick 180 reason="120 ticks warmup plus slack"
assert pawn "Bernael" hediff=BX_BabyBond_Feeder expect=present

damage "Baby" amount=9999
assert pawn "Baby" dead
assert pawn "Bernael" dead
