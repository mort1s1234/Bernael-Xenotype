rwtest 1
test "Soul caps at maximum" project="Bernael" group="Soul" created=2026-09-18T00:00:00

# Counter check to the balance math: nothing may overflow at the top end.
# Gene_Resource clamps to Max, InitialResourceMax is 1. Neither drinking a
# fragment nor a kill may go past it, and the surplus is lost, not stored.

requires dlc=Biotech
spawn Pawn:Colonist at 0,0 name="Bernael" xenotype=BX_Bernael
spawn Pawn:Pirate at 4,0 name="Pirate" faction=enemy
spawn Thing:BX_BottledSoul at 1,0

give "Bernael" resource=BX_SoulStarved value=1
ingest "Bernael" thing=BX_BottledSoul
assert pawn "Bernael" resource=BX_SoulStarved max=1

damage "Pirate" amount=999 by="Bernael"
assert pawn "Bernael" resource=BX_SoulStarved max=1
