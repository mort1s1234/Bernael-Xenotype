<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <BodyDef>
    <defName>BX_DarkDemon</defName>
    <label>dark demon</label>
    <corePart>
      <def>Torso</def>
      <height>Middle</height>
      <depth>Outside</depth>
      <groups>
        <li>Torso</li>
      </groups>
      <parts>
        <li>
          <def>BX_AbyssalShell</def>
          <customLabel>carapace plates</customLabel>
          <coverage>0.2</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>BX_SpectralCore</def>
          <customLabel>cold spectral core</customLabel>
          <coverage>0.05</coverage>
          <depth>Inside</depth>
          <groups>
            <li>Torso</li>
          </groups>
        </li>
        <li>
          <def>Neck</def>
          <customLabel>shadow neck</customLabel>
          <coverage>0.1</coverage>
          <height>Top</height>
          <groups>
            <li>Neck</li>
          </groups>
          <parts>
            <li>
              <def>Head</def>
              <customLabel>horned mask</customLabel>
              <coverage>0.80</coverage>
              <groups>
                <li>UpperHead</li>
                <li>FullHead</li>
                <li>HeadAttackTool</li>
              </groups>
              <parts>
                <li>
                  <def>Skull</def>
                  <customLabel>dread crown</customLabel>
                  <coverage>0.20</coverage>
                  <depth>Inside</depth>
                  <groups>
                    <li>UpperHead</li>
                    <li>FullHead</li>
                  </groups>
                  <parts>
                    <li>
                      <def>BX_VoidMind</def>
                      <customLabel>void mind</customLabel>
                      <coverage>0.80</coverage>
                      <groups>
                        <li>UpperHead</li>
                        <li>FullHead</li>
                      </groups>
                    </li>
                  </parts>
                </li>
                <li>
                  <def>BX_SpectralEye</def>
                  <customLabel>spectral eye</customLabel>
                  <coverage>0.10</coverage>
                  <groups>
                    <li>FullHead</li>
                    <li>Eyes</li>
                  </groups>
                  <woundAnchorTag>Eye</woundAnchorTag>
                </li>
              </parts>
            </li>
          </parts>
        </li>
        <li>
          <def>Shoulder</def>
          <customLabel>left spectral shoulder</customLabel>
          <coverage>0.15</coverage>
          <woundAnchorTag>LeftShoulder</woundAnchorTag>
          <groups>
            <li>Shoulders</li>
          </groups>
          <parts>
            <li>
              <def>BX_SpectralClawLimb</def>
              <customLabel>left spectral claw</customLabel>
              <coverage>0.75</coverage>
              <groups>
                <li>Arms</li>
                <li>LeftBlade</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>Shoulder</def>
          <customLabel>right spectral shoulder</customLabel>
          <coverage>0.15</coverage>
          <woundAnchorTag>RightShoulder</woundAnchorTag>
          <groups>
            <li>Shoulders</li>
          </groups>
          <parts>
            <li>
              <def>BX_SpectralClawLimb</def>
              <customLabel>right spectral claw</customLabel>
              <coverage>0.75</coverage>
              <groups>
                <li>Arms</li>
                <li>RightBlade</li>
              </groups>
            </li>
          </parts>
        </li>
        <li>
          <def>BX_PhantasmalDrift</def>
          <customLabel>phantasmal drift</customLabel>
          <coverage>0.01</coverage>
          <height>Bottom</height>
          <groups>
            <li>Legs</li>
          </groups>
        </li>
      </parts>
    </corePart>
  </BodyDef>

</Defs>
