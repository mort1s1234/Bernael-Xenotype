<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef>
    <defName>BX_BottledSoul</defName>
    <label>Bottled Soul essence</label>
    <description>Concentrated psychic essence harvested from living beings. All living creatures carry a soul, though animals and mechanoids bear only faint or weak echoes.
    
Bernaels rely entirely on this resource to sustain their survival, nature, and psionic power.

It can also be extracted from downed entropic demons, though doing so kills them immediately without triggering their death explosion.</description>
    <category>Item</category>
    <thingClass>ThingWithComps</thingClass>
    <drawerType>MapMeshOnly</drawerType>
    <useHitPoints>true</useHitPoints>
    <healthAffectsPrice>false</healthAffectsPrice>
    <selectable>true</selectable>
    <stackLimit>5</stackLimit>
    <tickerType>Rare</tickerType>
    <possessionCount>5</possessionCount>
    <socialPropernessMatters>true</socialPropernessMatters>
    <alwaysHaulable>true</alwaysHaulable>
    <pathCost>14</pathCost>
    <allowedArchonexusCount>-1</allowedArchonexusCount>
    <resourceReadoutPriority>Last</resourceReadoutPriority>
    <drawGUIOverlay>true</drawGUIOverlay>
    <graphicData>
      <texPath>Things/BottledSoul</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.85</drawSize>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <DeteriorationRate>2</DeteriorationRate>
      <Mass>1</Mass>
      <Flammability>0.3</Flammability>
      <Nutrition>0.3</Nutrition>
      <Beauty>-1</Beauty>
      <MarketValue>500</MarketValue>
    </statBases>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
    <ingestible>
      <foodType>Fluid</foodType>
      <preferability>DesperateOnly</preferability>
      <canAutoSelectAsFoodForCaravan>false</canAutoSelectAsFoodForCaravan>
      <nonDrugIngestibleWithoutFoodNeed>true</nonDrugIngestibleWithoutFoodNeed>
      <ingestSound>Ingest_Inject</ingestSound>
      <outcomeDoers>
        <li Class="Bernael_Xenotype.IngestionOutcomeDoer_OffsetSoul">
          <offset>0.4</offset>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
    </comps>
  </ThingDef>

</Defs>