<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <PawnKindDef Name="BX_CaligoBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>BX_SovereignsCaligo</defaultFactionDef>
    <initialWillRange>0~1</initialWillRange>
    <initialResistanceRange>55~65</initialResistanceRange>
    <styleItemTags MayRequire="Ludeon.RimWorld.Anomaly">
      <li>
        <tag>Cultist</tag>
        <baseWeight>5</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
    <apparelDisallowTags>
      <li>Western</li>
    </apparelDisallowTags>
  </PawnKindDef>

  <!-- 1. Vessels -->
  <PawnKindDef ParentName="BX_CaligoBase">
    <defName>BX_Caligo_Vessel</defName>
    <label>vessel</label>
    <combatPower>45</combatPower>
    <isGoodPsychicRitualInvoker>false</isGoodPsychicRitualInvoker>
    <studiableAsPrisoner>true</studiableAsPrisoner>
    <initialWillRange>0~2</initialWillRange>
    <initialResistanceRange>20~35</initialResistanceRange>
    <apparelMoney>150~500</apparelMoney>
    <apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
    <apparelColor>(55, 55, 65)</apparelColor>
    <apparelTags>
      <li>IndustrialBasic</li>
    </apparelTags>
    <weaponMoney>80~180</weaponMoney>
    <weaponTags>
      <li>NeolithicMeleeBasic</li>
      <li>MedievalMeleeDecent</li>
    </weaponTags>
    <specificApparelRequirements>
      <li>
        <apparelLayer>Shell</apparelLayer>
        <stuff>Cloth</stuff>
        <alternateTagChoices>
          <li>
            <tag>Robe</tag>
            <chance>1</chance>
          </li>
        </alternateTagChoices>
      </li>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <stuff>Cloth</stuff>
      </li>
    </specificApparelRequirements>
    <useFactionXenotypes>false</useFactionXenotypes>
    <xenotypeSet>
      <xenotypeChances>
        <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0.4</Neanderthal>
        <Hussar MayRequire="Ludeon.RimWorld.Biotech">0.2</Hussar>
      </xenotypeChances>
    </xenotypeSet>
  </PawnKindDef>

  <!-- 2. Renegades Base (Mercenary-inspired) -->
  <PawnKindDef Name="BX_Caligo_RenegadeBase" ParentName="BX_CaligoBase" Abstract="True">
    <maxGenerationAge>65</maxGenerationAge>
    <isGoodPsychicRitualInvoker>true</isGoodPsychicRitualInvoker>
    <disallowedTraitsWithDegree>
      <PsychicSensitivity>-1</PsychicSensitivity>
    </disallowedTraitsWithDegree>
    <chemicalAddictionChance>0.1</chemicalAddictionChance>
    <combatEnhancingDrugsChance>0.15</combatEnhancingDrugsChance>
    <combatEnhancingDrugsCount>0~2</combatEnhancingDrugsCount>
    <invNutrition>2.55</invNutrition>
    <itemQuality>Normal</itemQuality>
    <gearHealthRange>0.7~3.2</gearHealthRange>
    <apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
    <apparelColor>(30, 55, 85)</apparelColor>
    <apparelMoney>1000~1500</apparelMoney>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>IndustrialAdvanced</li>
      <li>IndustrialMilitaryBasic</li>
      <li>IndustrialMilitaryAdvanced</li>
      <li>BeltDefensePop</li>
    </apparelTags>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <stuff>Cloth</stuff>
        <alternateTagChoices>
          <li>
            <tag>Robe</tag>
            <chance>0.7</chance>
          </li>
        </alternateTagChoices>
      </li>
      <li>
        <bodyPartGroup>Legs</bodyPartGroup>
        <stuff>Cloth</stuff>
      </li>
    </specificApparelRequirements>
    <weaponMoney>330~650</weaponMoney>
    <techHediffsChance>0.15</techHediffsChance>
    <techHediffsMoney>700~1200</techHediffsMoney>
    <techHediffsTags>
      <li>Simple</li>
      <li>Advanced</li>
      <li>ImplantEmpireCommon</li>
    </techHediffsTags>
    <biocodeWeaponChance>0.2</biocodeWeaponChance>
    <disallowedTraits>
      <li>BodyPurist</li>
    </disallowedTraits>
    <inventoryOptions>
      <skipChance>0.9</skipChance>
      <subOptionsChooseOne>
        <li>
          <thingDef>MedicineIndustrial</thingDef>
          <countRange>1</countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef>

  <!-- 2a. Imperial Deserter -->
  <PawnKindDef ParentName="BX_Caligo_RenegadeBase">
    <defName>BX_Caligo_Imperial_Deserter</defName>
    <label>imperial deserter</label>
    <combatPower>65</combatPower>
    <backstoryFiltersOverride>
      <li>
        <categories>
          <li>ImperialFighter</li>
        </categories>
      </li>
    </backstoryFiltersOverride>
    <weaponMoney>1100~2700</weaponMoney>
    <weaponTags>
      <li>IndustrialGunAdvanced</li>
    </weaponTags>
    <apparelMoney>7000~10000</apparelMoney>
    <apparelAllowHeadgearChance>1.0</apparelAllowHeadgearChance>
    <apparelRequired>
      <li>Apparel_FlakJacket</li>
      <li>Apparel_FlakVest</li>
      <li>Apparel_FlakPants</li>
    </apparelRequired>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>UpperHead</bodyPartGroup>
        <alternateTagChoices>
          <li>
            <tag>Gunlink</tag>
            <chance>0.25</chance>
          </li>
        </alternateTagChoices>
      </li>
    </specificApparelRequirements>
    <techHediffsChance>0.3</techHediffsChance>
    <techHediffsMoney>1000~1500</techHediffsMoney>
    <techHediffsTags>
      <li>ImplantEmpireCommon</li>
    </techHediffsTags>
    <biocodeWeaponChance>0.15</biocodeWeaponChance>
    <skills>
      <li>
        <skill>Shooting</skill>
        <range>4~10</range>
      </li>
    </skills>
    <disallowedTraits>
      <li>Brawler</li>
    </disallowedTraits>
    <initialWillRange>2~4</initialWillRange>
    <initialResistanceRange>15~24</initialResistanceRange>
    <useFactionXenotypes>false</useFactionXenotypes>
    <xenotypeSet>
      <xenotypeChances>
        <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0.03</Neanderthal>
        <Hussar MayRequire="Ludeon.RimWorld.Biotech">0.25</Hussar>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0.03</Genie>
        <Starjack MayRequire="Ludeon.RimWorld.Biotech,Ludeon.RimWorld.Odyssey">0.03</Starjack>
      </xenotypeChances>
    </xenotypeSet>
  </PawnKindDef>

  <!-- 2b. Caligo Sniper -->
