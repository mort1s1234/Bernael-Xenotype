  <!-- 3. Warlocks -->
  <PawnKindDef Name="BX_Caligo_Warlock" ParentName="BX_CaligoBase">
    <defName>BX_Caligo_Warlock</defName>
    <label>warlock</label>
    <combatPower>165</combatPower>
    <itemQuality>Excellent</itemQuality>
    <isGoodPsychicRitualInvoker>true</isGoodPsychicRitualInvoker>
    <disallowedTraitsWithDegree>
      <PsychicSensitivity>-2</PsychicSensitivity>
    </disallowedTraitsWithDegree>
    <apparelMoney>7000~12000</apparelMoney>
    <apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
    <apparelColor>(114, 12, 12)</apparelColor>
    <apparelTags>
      <li>IndustrialBasic</li>
      <li>IndustrialAdvanced</li>
      <li>Psychic</li>
      <li>SpacerMilitary</li>
      <li>BX_Warlock</li>
    </apparelTags>
    <weaponMoney>3000~3500</weaponMoney>
    <weaponTags>
      <li>UltratechMelee</li>
      <li>EltexStaff</li>
      <li>BX_LifeVanquisher</li>
      <li>BX_SoulLantern</li>
    </weaponTags>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <stuff>Hyperweave</stuff>
      </li>
      <li>
        <bodyPartGroup>Legs</bodyPartGroup>
        <stuff>Hyperweave</stuff>
      </li>
    </specificApparelRequirements>
    <techHediffsChance>0.33</techHediffsChance>
    <techHediffsMoney>1000~4000</techHediffsMoney>
    <techHediffsTags>
      <li>Advanced</li>
      <li>ImplantEmpireRoyal</li>
      <li>ImplantEmpireCommon</li>
    </techHediffsTags>
    <techHediffsDisallowTags>
      <li>PainCauser</li>
