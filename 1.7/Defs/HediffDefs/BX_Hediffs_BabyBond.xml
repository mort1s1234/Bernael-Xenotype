<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>BX_BabyBond_Feeder</defName>
    <label>soulbound parent</label>
    <labelNoun>a soulbound parent bond</labelNoun>
    <description>A supernatural link binds this parent to an adopted child. The parent feels the child's pain as their own and will die if the child dies before reaching the age of 14.</description>
    <hediffClass>Bernael_Xenotype.Hediff_SoulboundParentBond</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.9)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="Bernael_Xenotype.HediffCompProperties_BabyBond_Feeder" />
    </comps>
    <stages>
      <li />
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>BX_BabyBond_Victim</defName>
    <label>soulbound child</label>
    <labelNoun>a soulbound child bond</labelNoun>
    <description>This child is bound to their adoptive parent. Their pain is shared and death for the child means death for the parent.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.9, 0.6, 0.9)</defaultLabelColor>
    <isBad>false</isBad>
    <everCurableByItem>false</everCurableByItem>
    <scenarioCanAdd>false</scenarioCanAdd>
    <comps>
      <li Class="Bernael_Xenotype.HediffCompProperties_BabyBond_Victim" />
    </comps>
    <stages>
      <li />
    </stages>
  </HediffDef>

</Defs>
